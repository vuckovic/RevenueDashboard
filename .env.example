# Copy to .env and fill in locally. .env is git-ignored — NEVER commit real values.

# --- PostgreSQL ---
PG_USER=postgres
PG_PASSWORD=
PG_DB=revenue
# PG_HOST is set to "db" by docker-compose; override only to use an external server
PG_PORT=5432

# --- Workday (RaaS report "DV_Customer Invoices") ---
# Full RaaS URL, e.g. https://<host>/ccx/service/customreport2/<tenant>/ISU_AR_Collector_DV/DV_Customer_Invoices
WORKDAY_REPORT_URL=
WORKDAY_USER=ISU_AR_Collector_DV
WORKDAY_PASSWORD=
# Optional: keep only paid invoices (field name / value as they appear in the report output)
WORKDAY_PAID_FIELD=
WORKDAY_PAID_VALUE=Paid
# Field that uniquely identifies an invoice in the report (unique key in wdar, no duplicates)
WORKDAY_ID_FIELD=referenceID
# Optional: fields that change daily and should not count as a change
WORKDAY_HASH_IGNORE=

# --- UBW / Unit4 (SOAP Query Engine, runs a saved browser template) ---
UBW_ENABLED=false
# Web-services endpoint (not the Default.aspx web client link)
UBW_WS_URL=https://ubw.unit4cloud.com/se_qva_prod_webservices/service.svc?QueryEngineService/QueryEngineV201101
UBW_USER=
UBW_CLIENT=
UBW_PASSWORD=
# Browser template id of the customer invoices / AR report (find it: python -m connectors.ubw templates)
UBW_TEMPLATE_ID=915
# Optional filter override: "col=value; col2=from..to; col3=" (empty = no restriction)
UBW_CRITERIA=
# Optional: keep only paid rows, and the column that uniquely identifies an invoice
UBW_PAID_FIELD=rest_curr
UBW_PAID_VALUE=0
UBW_ID_FIELD=
# Change log: fields that identify a row, and fields ignored when detecting changes
UBW_KEY_FIELDS=client,voucher_type,voucher_no,sequence_no
UBW_HASH_IGNORE=f0_dso

# --- Cash-flow dashboard (http://localhost:8000/cashflow) ---
# Source system -> company shown on the dashboard
CASHFLOW_COMPANIES=workday=Optiva,ubw=Qvantel
# EUR conversion uses ECB daily rates (table fx_rates, refreshed every sync).
# FX_TO_EUR is only a FALLBACK for currencies the ECB doesn't publish: 1 unit = x EUR.
# Currencies without any rate keep EUR columns empty and are listed in the sync message.
FX_TO_EUR=

# --- Scheduler ---
# Sync every hour on the hour between these local hours (inclusive), e.g. 8-17 = 08:00 ... 17:00
SYNC_HOURS=8-17
SYNC_TZ=Europe/Belgrade
SYNC_WEEKDAYS_ONLY=false
